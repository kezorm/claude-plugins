  padding:0;cursor:pointer;text-decoration:underline}
"""

JS = """
const q=document.getElementById('q');
const sites=[...document.querySelectorAll('details.site')];

// Filtering has to fight the collapsing: a match hidden inside a shut
// <details> is a match the user cannot see, so matched groups are forced open
// while a query is active and returned to their default state when it clears.
function apply(){
  const v=q.value.trim().toLowerCase();
  sites.forEach(d=>{
    let hit=0;
    d.querySelectorAll('.row').forEach(r=>{
      const m = !v || r.dataset.k.includes(v);
      r.hidden = !m; if(m) hit++;
    });
    d.hidden = hit===0;
    d.open = v ? hit>0 : d.dataset.open==='1';
    const c=d.querySelector('.count');
    if(!c.dataset.full) c.dataset.full=c.textContent;
    c.textContent = v ? hit+' of '+d.querySelectorAll('.row').length
                      : c.dataset.full;
  });
  document.querySelectorAll('section').forEach(s=>{
    s.hidden = ![...s.querySelectorAll('details.site')].some(d=>!d.hidden);
  });
}
q.addEventListener('input',apply);

document.getElementById('all').onclick=()=>sites.forEach(d=>{if(!d.hidden)d.open=true});
document.getElementById('none').onclick=()=>sites.forEach(d=>d.open=false);
q.focus();
"""


def build_index(root, min_words):
    items, hidden = collect(root, min_words)
    total = sum(len(v) for v in items.values())

    # Group by (section, site) once and measure once. Both the header total and
    # every per-group figure come from this same pass -- computing them
    # separately is how they end up disagreeing.
    by_site = {}
    for group, rows in items.items():
        for r in sorted(rows, key=lambda r: -r[3]):
            by_site.setdefault((group, r[4]), []).append(r)
    weight, overhead = account(root, items)
    disk = {k: sum(weight[r[1]] for r in rows) + overhead[k]
            for k, rows in by_site.items()}
    grand = sum(disk.values())
    out = ['<!doctype html><meta charset=utf-8><title>Archived content</title>',
           '<meta name=viewport content="width=device-width,initial-scale=1">',
           '<style>%s</style>' % CSS,
           '<header><b>Archived content — %d documents · %s</b>'
           '<input type=search id=q placeholder="Filter by title or path…">'
           '</header><main>' % (total, human(grand)),
           '<p class=note>Served over http:// so pages load their own images and '
           'stylesheets. Every entry has a text extraction beside it — for '
           'searching the contents rather than the titles, grep those. '
           'To browse the files directly instead, '
           '<a href="/reference/">start here</a>.</p>',
           '<p class=note>Sizes are the page <em>plus the images it pulls</em>. '
           'An image shared between pages is split between them, so nothing is '
           'double-counted: rows add up to their group, groups add up to the '
           'total above, and that total is what deleting the lot would '
           'reclaim. A group also carries any stylesheets and unreferenced '
           'files in its folder, which is why its total is a little more than '
           'its rows.</p>',
           '<p class=ctl>Grouped by source site. '
           '<button id=all>expand all</button>'
           '<button id=none>collapse all</button></p>']
    if hidden:
        out.append('<p class=note>%d item(s) hidden: RSS/Atom feeds saved as '
                   '.html (duplicates of pages archived beside them), and '
                   'documents under %d words — login pages and site furniture. '
                   '<code>--min-words 0</code> relaxes the word limit.</p>'
                   % (hidden, min_words))
    for group in sorted(items):
        keys = [k for k in by_site if k[0] == group]
        gtotal = sum(disk[k] for k in keys)
        rows_n = sum(len(by_site[k]) for k in keys)
        out.append('<section><h2>%s — %d · %s</h2>'
                   % (html.escape(group), rows_n, human(gtotal)))

        # Biggest group first: on this page the question is usually "what is
        # taking the room", not "what is alphabetically first".
        for key in sorted(keys, key=lambda k: -disk[k]):
            srows = by_site[key]
            site = key[1]
            # Show a short list straight away; collapse anything long enough to
            # be what made the page unreadable in the first place.
            openit = len(srows) <= COLLAPSE_OVER
            out.append(
                '<details class=site%s data-open="%d"><summary>%s'
                '<span class=count>%d · %s</span></summary>'
                % (' open' if openit else '', 1 if openit else 0,
                   html.escape(site), len(srows), human(disk[key])))

            for title, rel, txt, n, _site, nbytes, alts in srows:
                key_s = (title + ' ' + rel).lower().replace('"', '')
                # A <div>, not an <a>. The row carries a second link (to the
                # text extraction) and an anchor inside an anchor is invalid
                # HTML -- browsers close the outer one and the layout falls
                # apart.
                #
                # URL-escape before HTML-escaping. wget's --restrict-file-names
                # writes Wayback captures to paths holding a LITERAL percent
                # sign -- ".../20240915160007/https%3A/example.com/...". An
                # href carrying that raw is percent-DECODED by the server back
                # to "https:/", which does not exist, so every Wayback-captured
                # page 404s from the index. quote() turns the % into %25 and
                # the round trip lands on the real file. html.escape alone does
                # not do this.
                out.append(
                    '<div class=row data-k="%s">'
                    '<div class=head><a class=title href="/%s">%s</a>'
                    '<span class=tag>%s words · %s%s · '
                    '<a href="/%s">text</a></span>'
                    '</div><div class=meta>%s</div></div>'
                    % (html.escape(key_s), html.escape(quote(rel)),
                       html.escape(title[:120]),
                       format(n, ','), human(weight.get(rel, nbytes)),
                       (' · %d copies' % (alts + 1)) if alts else '',
                       html.escape(quote(txt)), html.escape(rel)))
            out.append('</details>')
        out.append('</section>')
    out.append('</main><script>%s</script>' % JS)
    path = os.path.join(root, INDEX)
    with open(path, 'w', encoding='utf-8') as fh:
        fh.write('\n'.join(out))
    return path, total, hidden


class QuietHandler(http.server.SimpleHTTPRequestHandler):
    """Serve the record, with the index -- not a directory listing -- at "/".

    The root of this repository is a pile of folders. Landing there means
    hunting for the archived page you want through the filesystem, which is
    precisely the job the index exists to do. So "/" serves the index, and the
    raw tree stays reachable underneath for anything the index does not list.
    """

    def send_head(self):
        if self.path in ('/', '/index.html'):
            self.path = '/' + INDEX
        return super().send_head()

    def log_message(self, *a):
        pass


def main():
    # Unbuffered-ish: this prints a URL and then blocks forever serving, so a
    # buffered stdout means the user stares at nothing when the output is piped
    # or captured.
    try:
        sys.stdout.reconfigure(line_buffering=True)
    except AttributeError:
        pass

    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument('--port', type=int, default=8765)
    ap.add_argument('--min-words', type=int, default=100)
    ap.add_argument('--index-only', action='store_true')
    ap.add_argument('--no-open', action='store_true')
    args = ap.parse_args()

    root = repo_root()
    path, total, hidden = build_index(root, args.min_words)
    print('indexed %d document(s) -> %s' % (total, os.path.relpath(path, root)))
    if args.index_only:
        return 0

    handler = functools.partial(QuietHandler, directory=root)
    socketserver.TCPServer.allow_reuse_address = True

    # Walk up until something is free. A busy port almost always means a copy
    # of this is already running -- a stale one from an earlier session, or
    # another terminal -- and refusing to start is a worse answer than moving
    # over by one and saying so.
    httpd = port = None
    for candidate in range(args.port, args.port + 12):
        try:
            httpd = socketserver.TCPServer(('127.0.0.1', candidate), handler)
            port = candidate
            break
        except OSError:
            continue
    if httpd is None:
        print('ports %d-%d are all busy on 127.0.0.1.' % (args.port, args.port + 11))
        print('probably stale servers from an earlier run:')
        print('  lsof -nP -iTCP:%d-%d -sTCP:LISTEN' % (args.port, args.port + 11))
        print('  pkill -f bin/archive-browse')
        return 1
    if port != args.port:
        print('port %d was busy — using %d instead '
              '(another copy is probably still running)' % (args.port, port))
    args.port = port

    url = 'http://127.0.0.1:%d/' % args.port
    print('serving %s' % root)
    print('  %s' % url)
    print('  loopback only — nothing is exposed to the network. ctrl-c to stop.')
    if not args.no_open:
        threading.Timer(0.4, lambda: webbrowser.open(url)).start()
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print('\nstopped')
    finally:
        httpd.server_close()
    return 0


if __name__ == '__main__':
    sys.exit(main())
