#!/usr/bin/env python3
"""Browse everything this record has archived, in a browser, offline.

    bin/archive-browse                 build the index, serve it, open a browser
    bin/archive-browse --index-only    just rebuild the index
    bin/archive-browse --port 9000     serve somewhere else

Archived pages are saved with their images and stylesheets, but opening one
straight off disk is unreliable: a file:// page cannot always load subresources
from sibling directories, so pages lose their images and CSS depending on the
browser. Served over http:// that restriction does not exist and archived pages
behave like ordinary web pages in anything.

So this serves the record on the loopback interface and writes an index of what
is in it. Nothing leaves the machine -- the bind address is 127.0.0.1 on
purpose, because the default binds every interface and would put a private
record on the local network.

What it does NOT do, because no viewer can:
  - repair pages that were incomplete when captured
  - restore JavaScript-driven behaviour, which archiving deliberately discards
  - search. That is `grep` over the .txt file beside every page, which is the
    whole reason those files exist.

Stdlib only, so it keeps working.
"""
import argparse
import collections
import functools
import hashlib
import html
import http.server
import os
import re
import socketserver
import sys
import threading
import urllib.parse
import webbrowser
from urllib.parse import quote

INDEX = '.archive-index.html'
SKIP_DIRS = {'.git', '.venv', '__pycache__', 'node_modules', '_inbox'}


def repo_root():
    here = os.path.dirname(os.path.abspath(__file__))
    return os.path.dirname(here)


def title_of(path):
    """A page's <title>, else its filename."""
    try:
        head = open(path, encoding='utf-8', errors='replace').read(20000)
    except OSError:
        return os.path.basename(path)
    m = re.search(r'(?is)<title[^>]*>(.*?)</title>', head)
    if not m:
        return os.path.basename(path)
    t = html.unescape(re.sub(r'\s+', ' ', m.group(1))).strip()
    return t or os.path.basename(path)


def words_in(txt):
    try:
        return len(open(txt, encoding='utf-8', errors='replace').read().split())
    except OSError:
        return 0


# A site group longer than this starts collapsed.
COLLAPSE_OVER = 8

HOSTISH = re.compile(r'^[a-z0-9][a-z0-9.-]*\.[a-z]{2,}$', re.I)


def site_of(rel):
    """The source host a saved page came from, read off its path.

    wget writes pages under their hostname, so the path already carries the
    answer -- except for Wayback captures, which nest the real host inside
    web.archive.org/web/<timestamp>/https%3A/<realhost>/... Grouping those
    under "web.archive.org" would file every rescued page together regardless
    of where it actually came from, which is the opposite of useful.

    Some folders hold pages saved flat, with no host component at all; those
    fall back to the folder name.
    """
    parts = rel.split(os.sep)[:-1]
    hosts = [x for x in parts if HOSTISH.match(x)]
    if not hosts:
        return parts[-1] if parts else '(root)'
    # "www.dazecars.com" and "dazecars.com" are one site, and wget will use
    # whichever the page linked to -- which put two of one article's images in
    # a separate group from the article. Fold the www. away.
    strip = lambda h: h[4:] if h.startswith('www.') else h
    if hosts[0].endswith('archive.org'):
        real = [h for h in hosts[1:] if not h.endswith('archive.org')]
        return (strip(real[0]) + '  · via Wayback') if real else 'web.archive.org'
    return strip(hosts[0])


def human(b):
    """Bytes as something a person can compare at a glance."""
    if b >= 1 << 30:
        return '%.1f GB' % (b / (1 << 30))
    if b >= 1 << 20:
        return '%.1f MB' % (b / (1 << 20))
    return '%d KB' % max(1, round(b / 1024))


def group_root(root, rel):
    """The directory a group's files live under.

    NOT the common path of its documents: a WordPress blog keeps its pages at
    <host>/2010/12/slug/ and its photographs at <host>/wp-content/uploads/, so
    a common path of the documents excludes every image and reports a folder as
    a hundredth of its real size. The host directory is the right boundary --
    and where a page was saved flat, with no host in the path, the folder it
    sits in is.
    """
    parts = rel.split(os.sep)
    for i, x in enumerate(parts[:-1]):
        if HOSTISH.match(x):
            return os.path.join(root, *parts[:i + 1])
    return os.path.join(root, *parts[:-1]) if len(parts) > 1 else root


def account(root, items):
    """Charge every byte in the archive to exactly one document or group.

    Three rules, in order:

    1. A file referenced by one or more pages is split evenly between them, so
       a logo on eight pages is counted once, not eight times.
    2. Anything left over -- stylesheets, orphaned images, files nothing points
       at -- is charged to the group whose directory contains it.
    3. Files under no group's directory are ignored; they are not archive.

    The point is that the arithmetic closes: rows sum to their group, groups
    sum to the header, and the header is what deleting the lot would reclaim.
    """
    docs = [(g, r) for g, rows in items.items() for r in rows]
    refs, users = {}, collections.Counter()
    for _, r in docs:
        p = os.path.join(root, r[1])
        d = os.path.dirname(p)
        try:
            body = open(p, encoding='utf-8', errors='replace').read()
        except OSError:
            refs[r[1]] = set()
            continue
        found = set()
        for u in re.findall(r'(?i)<img[^>]+src="([^"]+)"', body):
            u = html.unescape(u).split('#')[0]
            if not u or u.startswith(('http://', 'https://', 'data:', '//')):
                continue
            t = os.path.normpath(os.path.join(d, urllib.parse.unquote(u)))
            if os.path.isfile(t):
                found.add(t)
        refs[r[1]] = found
        for t in found:
            users[t] += 1

    size = {}
    def sz(t):
        if t not in size:
            try:
                size[t] = os.path.getsize(t)
            except OSError:
                size[t] = 0
        return size[t]

    weight = {}
    for _, r in docs:
        p = os.path.join(root, r[1])
        own = sz(p) + sz(os.path.splitext(p)[0] + '.txt')
        weight[r[1]] = own + sum(sz(t) / users[t] for t in refs[r[1]])

    # rule 2: leftovers to the group that contains them
    claims = sorted(
        {(os.path.normpath(group_root(root, r[1])), (g, r[4])) for g, r in docs},
        key=lambda c: -len(c[0]))
    counted = set(users) | {os.path.join(root, r[1]) for _, r in docs}
    counted |= {os.path.splitext(os.path.join(root, r[1]))[0] + '.txt'
                for _, r in docs}
    overhead = collections.Counter()
    for dp, dirnames, fs in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS
                       and not d.startswith('.')]
        here = os.path.normpath(dp)
        owner = next((k for pre, k in claims
                      if here == pre or here.startswith(pre + os.sep)), None)
        if owner is None:
            continue
        for f in fs:
            t = os.path.join(dp, f)
            if t not in counted:
                overhead[owner] += sz(t)
    return weight, overhead


def is_feed(path):
    """True if this .html file is really RSS/Atom XML."""
    try:
        with open(path, 'rb') as fh:
            head = fh.read(200).lstrip()
    except OSError:
        return False
    return head[:5] == b'<?xml' or head[:4].lower() == b'<rss' or \
        head[:5].lower() == b'<feed'


def collect(root, min_words):
    """Archived documents: a page or PDF with a .txt extraction beside it.

    That pairing is the convention `archive-page` and `extract-text` both
    follow, and it is a good proxy for "something was deliberately archived
    here" rather than "a stylesheet happens to live in this folder".
    """
    items, hidden, seen = {}, 0, {}
    for dp, dirnames, fs in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS
                       and not d.startswith('.')]
        for f in sorted(fs):
            if not f.lower().endswith(('.html', '.htm', '.pdf')):
                continue
            p = os.path.join(dp, f)
            txt = os.path.splitext(p)[0] + '.txt'
            if not os.path.exists(txt):
                continue
            # RSS/Atom saved with an .html name. WordPress publishes a feed for
            # the site, every category, every tag, every author and every post
            # -- 86 of them on one mirror -- and wget saves each as index.html
            # inside a feed/ directory. A browser then tries to parse XML as
            # HTML and renders a mess, which is how these were noticed.
            #
            # They are also pure duplication: a feed carries the post body in
            # <content:encoded>, so every word is already in a page archived
            # beside it. Not documents; they do not belong in a reading index.
            if is_feed(p):
                hidden += 1
                continue
            n = words_in(txt)
            rel = os.path.relpath(p, root)
            if n < min_words:
                hidden += 1
                continue
            group = rel.split(os.sep)[0]
            if group.startswith('reference') and os.sep in rel:
                group = os.sep.join(rel.split(os.sep)[:2])
            # Collapse byte-identical duplicates. A WordPress mirror emits
            # the same post at ?replytocom=N for every comment and again at
            # ?p=NNNN, so one krissmotors article was listed NINE times under
            # an identical title -- 253 rows for 196 documents. The copies are
            # kept on disk (deleting committed files reclaims nothing) but the
            # index shows the canonical one and counts the rest.
            key = hashlib.md5(
                open(txt, 'rb').read()).hexdigest() if os.path.exists(txt) else rel
            canonical = '?' not in rel
            if key in seen:
                prev = seen[key]
                prev['alts'] += 1
                # prefer the tidy URL: no query string, then the shortest
                if canonical and ('?' in prev['row'][1]) or (
                        canonical == ('?' not in prev['row'][1])
                        and len(rel) < len(prev['row'][1])):
                    prev['row'] = (prev['row'][0], rel,
                                   os.path.relpath(txt, root), n,
                                   site_of(rel), os.path.getsize(p))
                continue
            row = (title_of(p) if not f.lower().endswith('.pdf')
                   else os.path.basename(p), rel, os.path.relpath(txt, root), n,
                   site_of(rel), os.path.getsize(p))
            entry = {'row': row, 'alts': 0, 'group': group}
            seen[key] = entry
            items.setdefault(group, []).append(entry)
    # flatten: row tuple + how many identical copies it stands for
    for g in items:
        items[g] = [e['row'] + (e['alts'],) for e in items[g]]
    return items, hidden


CSS = """
:root{--bg:#f4f4f1;--fg:#141414;--muted:#4a4a48;--card:#fff;--line:#c9c9c4;--link:#0b4fa8}
@media(prefers-color-scheme:dark){:root{--bg:#131517;--fg:#eceded;--muted:#b4b8bb;
  --card:#1e2124;--line:#3a3f44;--link:#7fb8ff}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);
     font:16px/1.6 -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
a{color:var(--link)}
header{position:sticky;top:0;background:var(--card);border-bottom:1px solid var(--line);
       padding:12px 20px;z-index:9}
header b{font-size:15px}
main{max-width:960px;margin:0 auto;padding:22px 20px 80px}
input[type=search]{width:100%;padding:9px 12px;font-size:15px;margin-top:9px;
  border:1px solid var(--line);border-radius:7px;background:var(--bg);color:var(--fg)}
h2{font-size:13px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);
   margin:26px 0 8px;border-bottom:1px solid var(--line);padding-bottom:5px}
.row{background:var(--card);border:1px solid var(--line);border-radius:9px;
     padding:10px 14px;margin:7px 0}
.row:hover{border-color:var(--link)}
.head{display:flex;align-items:baseline;gap:12px}
.title{font-size:15px;font-weight:600;text-decoration:none;flex:1;min-width:0}
.title:hover{text-decoration:underline}
.tag{font-size:12px;color:var(--muted);white-space:nowrap;flex:none}
.meta{font-size:12.5px;color:var(--muted);word-break:break-all;margin-top:2px}
.note{font-size:13.5px;color:var(--muted);margin:6px 0 0}
details.site{margin:7px 0}
details.site>summary{cursor:pointer;list-style:none;padding:7px 12px;
  background:var(--card);border:1px solid var(--line);border-radius:9px;
  font-size:14px;font-weight:600;display:flex;align-items:center;gap:9px}
details.site>summary::-webkit-details-marker{display:none}
details.site>summary::before{content:'\u25B8';color:var(--muted);font-weight:400;
  flex:none;transition:transform .12s}
details.site[open]>summary::before{transform:rotate(90deg)}
details.site>summary:hover{border-color:var(--link)}
